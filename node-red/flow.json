[
  {
    "id": "aba_pulso",
    "type": "tab",
    "label": "Pulso Band - Dashboard",
    "disabled": false,
    "info": "Dashboard de monitoramento cardiaco do Pulso Band (Fase 3 - CardioIA)."
  },
  {
    "id": "broker_hivemq",
    "type": "mqtt-broker",
    "name": "HiveMQ Publico",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "node-red-pulso-rm567951",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "grupo_dash",
    "type": "ui_group",
    "name": "Sinais Vitais",
    "tab": "aba_ui",
    "order": 1,
    "disp": true,
    "width": "8"
  },
  {
    "id": "aba_ui",
    "type": "ui_tab",
    "name": "Pulso Band",
    "icon": "favorite",
    "order": 1
  },
  {
    "id": "mqtt_in_telemetria",
    "type": "mqtt in",
    "z": "aba_pulso",
    "name": "pulso/band/rm567951/telemetria",
    "topic": "pulso/band/rm567951/telemetria",
    "qos": "1",
    "broker": "broker_hivemq",
    "x": 170,
    "y": 120,
    "wires": [["parse_json"]]
  },
  {
    "id": "parse_json",
    "type": "json",
    "z": "aba_pulso",
    "name": "Parse JSON",
    "property": "payload",
    "x": 390,
    "y": 120,
    "wires": [["func_bpm", "func_temp", "func_alerta"]]
  },
  {
    "id": "func_bpm",
    "type": "function",
    "z": "aba_pulso",
    "name": "Extrai BPM",
    "func": "// Isola o campo bpm para o grafico de linha.\nmsg.payload = msg.payload.bpm;\nreturn msg;",
    "outputs": 1,
    "x": 610,
    "y": 60,
    "wires": [["chart_bpm"]]
  },
  {
    "id": "func_temp",
    "type": "function",
    "z": "aba_pulso",
    "name": "Extrai Temperatura",
    "func": "// Isola o campo temperatura para o gauge.\nmsg.payload = msg.payload.temperatura;\nreturn msg;",
    "outputs": 1,
    "x": 620,
    "y": 120,
    "wires": [["gauge_temp"]]
  },
  {
    "id": "func_alerta",
    "type": "function",
    "z": "aba_pulso",
    "name": "Avalia Alerta",
    "func": "// Limites clinicos: bpm > 100 OU temperatura > 37.8 C.\nvar bpm = msg.payload.bpm;\nvar temp = msg.payload.temperatura;\nif (bpm > 100 || temp > 37.8) {\n    msg.payload = 'ALERTA: ' + bpm + ' bpm / ' + temp + ' C';\n    msg.cor = 'red';\n} else {\n    msg.payload = 'Normal: ' + bpm + ' bpm / ' + temp + ' C';\n    msg.cor = 'green';\n}\nreturn msg;",
    "outputs": 1,
    "x": 610,
    "y": 180,
    "wires": [["texto_alerta"]]
  },
  {
    "id": "chart_bpm",
    "type": "ui_chart",
    "z": "aba_pulso",
    "name": "Batimentos (bpm)",
    "group": "grupo_dash",
    "order": 1,
    "width": "8",
    "height": "4",
    "label": "Batimentos cardiacos (bpm)",
    "chartType": "line",
    "ymin": "0",
    "ymax": "200",
    "removeOlder": "10",
    "removeOlderUnit": "60",
    "x": 850,
    "y": 60,
    "wires": [[]]
  },
  {
    "id": "gauge_temp",
    "type": "ui_gauge",
    "z": "aba_pulso",
    "name": "Temperatura",
    "group": "grupo_dash",
    "order": 2,
    "width": "4",
    "height": "4",
    "gtype": "gage",
    "title": "Temperatura (C)",
    "label": "C",
    "format": "{{value}}",
    "min": "30",
    "max": "45",
    "seg1": "37.8",
    "seg2": "40",
    "x": 850,
    "y": 120,
    "wires": []
  },
  {
    "id": "texto_alerta",
    "type": "ui_text",
    "z": "aba_pulso",
    "name": "Indicador de Alerta",
    "group": "grupo_dash",
    "order": 3,
    "width": "8",
    "height": "2",
    "label": "Status",
    "format": "<span style='color:{{msg.cor}}; font-weight:bold'>{{msg.payload}}</span>",
    "layout": "row-left",
    "x": 860,
    "y": 180,
    "wires": []
  }
]
